<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="klp4"/>
        <attribute name="authors" value="Chikara"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-18 01:37:43 PM"/>
        <attribute name="created" value="Q2hpa2FyYTtMQVBUT1AtNFBIQTNTUTU7MjAyNi0wOS0xMTswNjo0OTozMyBQTTszMDI3"/>
        <attribute name="edited" value="Q2hpa2FyYTtMQVBUT1AtNFBIQTNTUTU7MjAyNi0wOS0xODswMTozNzo0MyBQTTs0OzMxMzg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pendapatan" type="Real" array="False" size=""/>
            <declare name="jumlahPengeluaran" type="Integer" array="False" size=""/>
            <declare name="kategori" type="String" array="False" size=""/>
            <declare name="nominalPengeluaran" type="Real" array="False" size=""/>
            <declare name="totalPengeluaran" type="Real" array="False" size=""/>
            <declare name="sisaSaldo" type="Real" array="False" size=""/>
            <declare name="persentaseSaldo" type="Real" array="False" size=""/>
            <declare name="kondisiKeuangan" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukkan total pendapatan: Rp&quot;" newline="True"/>
            <input variable="pendapatan"/>
            <output expression="&quot;Masukkan jumlah kategori pengeluaran&quot;" newline="True"/>
            <input variable="jumlahPengeluaran"/>
            <assign variable="totalPengeluaran" expression="0"/>
            <for variable="i" start="1" end="jumlahPengeluaran" direction="inc" step="1">
                <output expression="&quot;Masukkan kategori pengeluaran ke-&quot; &amp;i&amp; &quot;:&quot;" newline="True"/>
                <input variable="kategori"/>
                <output expression="&quot;Masukkan jumlah pengeluaran ke-&quot; &amp;i&amp; &quot;: Rp&quot;" newline="True"/>
                <input variable="nominalPengeluaran"/>
                <assign variable="totalPengeluaran" expression="totalPengeluaran + nominalPengeluaran"/>
            </for>
            <assign variable="sisaSaldo" expression="pendapatan - totalPengeluaran"/>
            <assign variable="persentaseSaldo" expression="(sisaSaldo/pendapatan)*100"/>
            <if expression="persentaseSaldo &gt;= 30">
                <then>
                    <assign variable="kondisiKeuangan" expression="&quot;baik&quot;"/>
                </then>
                <else>
                    <if expression="persentaseSaldo &gt;= 10">
                        <then>
                            <assign variable="kondisiKeuangan" expression="&quot;perlu diperhatikan&quot;"/>
                        </then>
                        <else>
                            <assign variable="kondisiKeuangan" expression="&quot;kritis&quot;"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;=====RINGKASAN ANGGARAN=====&quot;" newline="True"/>
            <output expression="&quot;Pendapatan    : Rp&quot; &amp;pendapatan" newline="True"/>
            <output expression="&quot;Total Pengeluaran : Rp&quot; &amp; totalPengeluaran" newline="True"/>
            <output expression="&quot;Sisa saldo   : Rp&quot; &amp; sisaSaldo" newline="True"/>
            <output expression="&quot;Persentase saldo  :&quot; &amp;persentaseSaldo &amp;&quot;%&quot;" newline="True"/>
            <output expression="&quot;kondisi keuangan:&quot; &amp; kondisiKeuangan" newline="True"/>
        </body>
    </function>
</flowgorithm>
